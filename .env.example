# Supabase project (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the email-confirmation redirect link. Use http://localhost:3000
# in development and your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic API key (https://console.anthropic.com/settings/keys), used by the
# in-app chat to answer questions about your finances.
ANTHROPIC_API_KEY=

# Service role key (Supabase -> Settings -> API Keys -> Secret keys). Used
# ONLY server-side by the Discord bot, which has no browser session. Never
# expose this to the browser (no NEXT_PUBLIC_ prefix, ever).
SUPABASE_SERVICE_ROLE_KEY=

# Discord bot (see README "Discord bot" section for how to create these).
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
